# Copy to .env (gitignored) and fill in. Nothing loads it automatically:
#   set -a; . ./.env; set +a
# The default `npm test` replays committed cassettes and needs none of these.

# record | replay | live. Unset means `replay` for the library
# (installFromEnv), so CI never hits the real API, and `live` for the example
# app's server boot, where installing a stub would be worse than not.
ANTHROPIC_TEST_MODE=replay

# Needed for `record` and `live`. The example app substitutes a placeholder
# when this is unset or blank, which is enough for `replay`.
ANTHROPIC_API_KEY=sk-ant-your-key-here
